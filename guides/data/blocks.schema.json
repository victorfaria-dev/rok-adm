{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rok-adm/guides/blocks.schema.json",
  "title": "Guide blocks (I-05 modular guide architecture)",
  "description": "Array of tagged guide blocks. The questionnaire (F-01) filters and orders them; the guide Markdown/HTML is assembled from them. Cross-checks against research/facts (card status/confidence, gap IDs) are done by guides/tools/validate_blocks.py, not by this schema.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "phase", "section", "order", "stage", "perfil", "funcao",
                 "hours_min_per_day", "time_cost_min", "priority", "recommended_for",
                 "ch_range", "civ", "consensus", "split_views", "body_md", "why_md",
                 "cards", "patch_cards", "confidence", "uncertain_notes", "gaps",
                 "low_spender_note", "as_of", "patch_ref"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Stable slug; never reuse a retired id."},
      "title": {"type": "string", "minLength": 3},
      "phase": {"type": "string", "enum": ["overview", "day0-3", "day4-14", "day15-40", "day41-90", "pre-kvk1", "daily", "event", "anytime"],
                "description": "When in the kingdom's life the block applies (kingdom days)."},
      "section": {"type": "string", "enum": ["overview", "day0", "plan", "daily", "events", "farms", "mistakes", "recovery", "open"],
                  "description": "Guide chapter the block is assembled into."},
      "order": {"type": "integer", "minimum": 0, "description": "Sort key inside the guide."},
      "stage": {"type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "enum": ["todos", "pre_kvk", "kvk1", "kvk2", "kvk3", "soc"]},
                "description": "Kingdom stage (estagio_reino in research/schemas/fato.md)."},
      "perfil": {"type": "array", "minItems": 1, "uniqueItems": true,
                 "items": {"type": "string", "enum": ["todos", "f2p", "low", "medium", "high", "whale", "kraken"]},
                 "description": "Spending profiles the block is shown to (research/perfis.md)."},
      "funcao": {"type": "array", "minItems": 1, "uniqueItems": true,
                 "items": {"type": "string", "enum": ["todas", "lutador", "farm", "rally", "guarnicao", "lider"]}},
      "hours_min_per_day": {"type": ["number", "null"], "minimum": 0,
                            "description": "Minimum daily play time (hours) at which the block applies; null = any."},
      "time_cost_min": {"type": ["number", "null"], "minimum": 0,
                        "description": "Measured minutes of play the block costs; null until measured (T0)."},
      "priority": {"type": "integer", "minimum": 1, "maximum": 5, "description": "5 = do first."},
      "recommended_for": {"type": "array", "uniqueItems": true,
                          "items": {"type": "string", "enum": ["f2p", "low", "medium", "high", "whale", "kraken"]},
                          "description": "Profiles for which the block's main option is marked Recommended."},
      "ch_range": {"type": ["array", "null"], "minItems": 2, "maxItems": 2,
                   "items": {"type": "integer", "minimum": 1, "maximum": 25},
                   "description": "[min, max] City Hall where the block is relevant; null = any."},
      "civ": {"type": "array", "uniqueItems": true, "items": {"type": "string"},
              "description": "Civilizations the block is specific to; empty = all."},
      "consensus": {"type": "string", "enum": ["unanimous", "majority", "split", "minority", "single-source", "mechanic", "n/a"]},
      "split_views": {"type": ["string", "null"], "description": "Both views, required when consensus = split."},
      "body_md": {"type": "string", "minLength": 20},
      "why_md": {"type": "string", "minLength": 20},
      "cards": {"type": "array", "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[ABC][0-9]{2}-[0-9]{4}$"},
                "description": "Every fact card cited anywhere in the block."},
      "patch_cards": {"type": "array", "uniqueItems": true,
                      "items": {"type": "string", "pattern": "^C04-[0-9]{4}$"},
                      "description": "C04 patch-state cards (official notes, confianca >= media) cited although their status is not yet 'verificado'."},
      "confidence": {"type": "string", "enum": ["high", "medium", "low", "pending"]},
      "uncertain_notes": {"type": "string", "description": "Must name every cited card that is below the firm filter (verificado + confianca >= media), except patch_cards."},
      "gaps": {"type": "array", "uniqueItems": true,
               "items": {"type": "string", "pattern": "^(L-[A-C][0-9]{2}-[0-9]{2}|PROPOSED-[A-Z0-9-]+)$"}},
      "low_spender_note": {"type": ["string", "null"]},
      "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
      "patch_ref": {"type": "string"}
    }
  }
}

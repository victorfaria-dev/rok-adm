# Sign-in with Supabase (optional). Copy to apps/web/.env (gitignored) for local work, or set the
# same names in Netlify → Site configuration → Environment variables. See supabase/README.md.
# Leave them empty and the site works as before: no sign-in, no route guard.
#
# Both values are public by design (they ship in the browser bundle); data is protected by the
# row-level security in supabase/migrations. Never put the service_role key anywhere in this repo.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

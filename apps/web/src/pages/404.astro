---
import Shell from "../layouts/Shell.astro";
---
<Shell title="Page not found" description="This page does not exist." mode="read">
  <section class="nf">
    <h1>Page not found</h1>
    <p>The link may be old or mistyped.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/guide/">Open the guide</a>
      <a class="btn btn-secondary" href="/">Go home</a>
    </div>
  </section>
</Shell>

<style>
  .nf { display: grid; gap: var(--ko-space-4); padding-block: var(--ko-space-6); }
  h1 { font-size: var(--ko-text-3xl); }
  p { color: var(--ko-text-muted); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--ko-space-3); }
</style>

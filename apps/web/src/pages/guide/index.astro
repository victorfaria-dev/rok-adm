---
// Screen 3 (plan §4): the default F2P guide is rendered here at build (indexable,
// readable without JS). The island re-filters it for ?p= or the saved profile.
import Shell from "../../layouts/Shell.astro";
import GuideIsland from "../../components/guide/GuideIsland";
import { GuideBody, GuideMeta, GuidesForYou } from "../../components/guide/GuideBody";
import { GuideVisual } from "../../components/guide/GuideVisual";
import { defaultGuideLinks } from "../../lib/guides";
import { buildGuideData } from "../../lib/guide-payload";
import { selectGuide } from "../../lib/guide-view";
import { profileSummary } from "../../lib/profile";
import { defaultProfile } from "@rokadm/core";
import "../../styles/guide.css";

const data = buildGuideData();
const view = selectGuide(data.guide, defaultProfile());
---
<Shell title="Seu guia" description="Um plano F2P passo a passo até o KvK1, com fontes, conferência de atualização e um teste de realidade do orçamento. Personalize para o seu gasto, tempo de jogo e Prefeitura." mode="read">
  <div class="g-page">
    <h1>Seu guia</h1>
    <GuideIsland client:load dataUrl="/data/guide.json">
      <div data-guide="default">
        <aside class="g-banner" aria-labelledby="g-banner-h">
          <p id="g-banner-h" class="g-banner-title">Personalize em 2 minutos</p>
          <p>Este é o guia padrão para uma conta F2P nova. Responda 5 perguntas rápidas e ele se ajusta ao seu gasto, tempo de jogo e Prefeitura.</p>
          <a class="btn btn-primary" href="/start/">Montar meu guia</a>
        </aside>
        <GuideMeta view={view} label={`Guia padrão para ${profileSummary(defaultProfile())}`} />
        <GuidesForYou links={defaultGuideLinks()} title="Outros guias" />
        <GuideVisual view={view} badges={data.guide.badges} calendar={data.calendar} />
        <GuideBody view={view} badges={data.guide.badges} budget={data.budget} />
      </div>
    </GuideIsland>
  </div>
</Shell>

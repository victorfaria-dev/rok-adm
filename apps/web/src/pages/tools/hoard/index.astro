---
import Shell from "../../../layouts/Shell.astro";
import HoardCalc, { type SaveKind } from "../../../components/tools/hoard/HoardCalc";
import RuleList from "../../../components/tools/hoard/RuleList.astro";
import DataStamp from "../../../components/tools/kit/DataStamp.astro";
import SourcesList from "../../../components/tools/kit/SourcesList.astro";
import { cite } from "../../../lib/tools-payload";
import hoard from "../../../../../../packages/planner/tools-data/hoard.json";
import "../../../components/tools/kit/tools.css";

const SAVE: Record<SaveKind, string> = { ap: "itens de recuperação de PA", gems: "gemas", speedups: "acelerações", resources: "recursos (como itens)" };
const goals = hoard.goals.map((g) => ({ id: g.id, title: g.title, save: g.save as SaveKind[] }));
const cites = Object.fromEntries(hoard.goals.map((g) => [g.id, cite(g.rules.flatMap((r) => r.facts))]));
const ids = [...hoard.goals.flatMap((g) => g.rules.flatMap((r) => r.facts)), ...hoard.general.flatMap((r) => r.facts)];
---
<Shell title="Guia de acúmulo" description="O que guardar em Rise of Kingdoms para a Provação de Lohar, Mais que Gemas, Véspera da Cruzada, KvK e MGE, e por quê. Sem datas: os eventos não têm calendário fixo. Cada regra cita sua fonte." mode="operate">
  <div class="t-page">
    <header>
      <h1>Guia de acúmulo</h1>
      <p class="t-lead">O que guardar para cada evento, e por quê. Sem datas: o calendário dos eventos não é fixo, então acompanhe o calendário do jogo. Os valores que você digita ficam neste aparelho.</p>
      <DataStamp />
    </header>

    {hoard.goals.map((g) => (
      <section class="t-section" aria-labelledby={`hoard-${g.id}-h`} data-goal={g.id}>
        <h2 id={`hoard-${g.id}-h`}>{g.title}</h2>
        <p class="t-note">Guardar: {g.save.map((s) => SAVE[s as SaveKind]).join(", ")}.</p>
        <RuleList rules={g.rules} />
      </section>
    ))}

    <section class="t-section" aria-labelledby="hoard-general-h">
      <h2 id="hoard-general-h">Para qualquer meta</h2>
      <RuleList rules={hoard.general} testId="hoard-general" />
    </section>

    <section class="t-section" aria-labelledby="hoard-calc-h">
      <h2 id="hoard-calc-h">Guardado e meta</h2>
      <p class="t-note">As quantidades guardadas são compartilhadas com as outras ferramentas neste aparelho. As metas são suas: nenhuma ficha as traz.</p>
      <HoardCalc client:load goals={goals} cites={cites} />
    </section>

    <section class="t-deferred" aria-labelledby="t-deferred-h">
      <h2 id="t-deferred-h">Ainda não está aqui</h2>
      <ul>
        <li>Quantidades sugeridas por evento (quantos itens de PA para a Provação de Lohar, acelerações para as metas do MGE): precisa de medições no jogo.</li>
        <li>Lembretes antes de um evento: depende do calendário do reino.</li>
      </ul>
    </section>
    <SourcesList ids={ids} />
  </div>
</Shell>

---
import Shell from "../../../layouts/Shell.astro";
import ApCalc from "../../../components/tools/ap/ApCalc";
import DataStamp from "../../../components/tools/kit/DataStamp.astro";
import SourcesList from "../../../components/tools/kit/SourcesList.astro";
import { cite, sourced } from "../../../lib/tools-payload";
import ap from "../../../../../../packages/planner/tools-data/ap.json";
import "../../../components/tools/kit/tools.css";

const props = {
  cap: sourced(ap.cap).value,
  dailyClaim: sourced(ap.dailyClaim).value,
  barbarian: { base: ap.barbarianBase.value, step: ap.barbarianStep.value, maxStreak: ap.barbarianMaxStreak.value },
  insightMax: ap.insightMax.value,
  pack: { ap: ap.packAp.value, startGems: ap.packStartGems.value, stepGems: ap.packStepGems.value },
  cites: {
    cap: cite(ap.cap.facts),
    claim: cite(ap.dailyClaim.facts),
    barbarian: cite([...ap.barbarianBase.facts, ...ap.barbarianStep.facts, ...ap.barbarianMaxStreak.facts, ...ap.insightMax.facts]),
    pack: cite([...ap.packAp.facts, ...ap.packStartGems.facts, ...ap.packStepGems.facts]),
  },
};
const ids = [...ap.cap.facts, ...ap.dailyClaim.facts, ...ap.barbarianBase.facts, ...ap.packAp.facts];
---
<Shell title="Action Points" description="How many barbarians one chain of attacks takes with your AP, your AP after the daily claim, and the gem price of buying more AP today." mode="operate">
  <div class="t-page">
    <header>
      <h1>Action Points</h1>
      <p class="t-lead">Barbarian attacks per chain, AP after the daily claim, and what buying AP with gems costs today. The base regeneration rate is not in our data: enter your own if you measured it. Values stay on this device.</p>
      <DataStamp />
    </header>
    <ApCalc client:load {...props} />
    <SourcesList ids={ids} />
  </div>
</Shell>

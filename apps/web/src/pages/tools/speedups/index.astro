---
import Shell from "../../../layouts/Shell.astro";
import SpeedupsCalc from "../../../components/tools/speedups/SpeedupsCalc";
import DataStamp from "../../../components/tools/kit/DataStamp.astro";
import SourcesList from "../../../components/tools/kit/SourcesList.astro";
import { cite, levelTable, sourced } from "../../../lib/tools-payload";
import sp from "../../../../../../packages/planner/tools-data/speedups.json";
import "../../../components/tools/kit/tools.css";

const COL = "Times You Can Be Helped";
const ac = levelTable("A01-buildings-alliance-center", [COL]);
const helps = ac.rows.flatMap((r) => (r.stats[COL] == null ? [] : [{ level: r.level, helps: r.stats[COL]! }]));
const pct = sourced(sp.helpPct);
// Item durations are labels printed in item names; A04-0007's VIP Shop table names several of them.
const durationIds = ["A04-0007"];
const props = {
  helps,
  helpPct: pct.value,
  cites: { durations: cite(durationIds), helps: ac.cite, helpPct: cite(sp.helpPct.facts) },
};
const ids = [...durationIds, ...ac.cite.facts, ...sp.helpPct.facts];
---
<Shell title="Speedups and time" description="Add up your speedups by type, see the grand total, and check whether they finish a building, research, training or healing job after alliance helps." mode="operate">
  <div class="t-page">
    <header>
      <h1>Speedups and time</h1>
      <p class="t-lead">Type how many speedup items you hold. You get the time per type and in total, and whether they finish a job once alliance helps are counted. Values stay on this device.</p>
      <DataStamp />
    </header>
    <SpeedupsCalc client:load {...props} />
    <SourcesList ids={ids} />
  </div>
</Shell>

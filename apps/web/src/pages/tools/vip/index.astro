---
import Shell from "../../../layouts/Shell.astro";
import VipCalc from "../../../components/tools/vip/VipCalc";
import DataStamp from "../../../components/tools/kit/DataStamp.astro";
import SourcesList from "../../../components/tools/kit/SourcesList.astro";
import { cite, sourced } from "../../../lib/tools-payload";
import { getTable } from "@rokadm/data";
import vip from "../../../../../../packages/planner/tools-data/vip.json";
import "../../../components/tools/kit/tools.css";

const t = getTable("A05-vip-levels");
const levels = t.rows
  .map((r) => ({ vip: Number(r.vip_level), threshold: Number(r.vip_points_threshold) }))
  .filter((l) => Number.isFinite(l.vip) && Number.isFinite(l.threshold));
const perGem = sourced(vip.gemToVip), start = sourced(vip.chestStart), inc = sourced(vip.chestIncrement), cap = sourced(vip.chestCap), daily = sourced(vip.dailyGems);
const props = {
  levels,
  rule: { start: start.value, increment: inc.value, cap: cap.value },
  perGem: perGem.value,
  dailyGems: daily.value,
  cites: { thresholds: cite(t.factIds), chest: cite(vip.chestStart.facts), gems: cite(vip.gemToVip.facts), dailyGems: cite(vip.dailyGems.facts) },
};
const ids = [...t.factIds, ...vip.chestStart.facts, ...vip.gemToVip.facts, ...vip.dailyGems.facts];
---
<Shell title="Gems to VIP" description="How many VIP points and gems you need for your next VIP level, and how many days the daily chest takes. Every number cites its fact card." mode="operate">
  <div class="t-page">
    <header>
      <h1>Gems to VIP</h1>
      <p class="t-lead">Points and gems to your target VIP level, and the days it takes with the daily VIP chest. Values stay on this device.</p>
      <DataStamp />
    </header>
    <VipCalc client:load {...props} />
    <SourcesList ids={ids} />
  </div>
</Shell>

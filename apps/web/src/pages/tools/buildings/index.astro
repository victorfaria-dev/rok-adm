---
import Shell from "../../../layouts/Shell.astro";
import BuildingsCalc from "../../../components/tools/buildings/BuildingsCalc";
import DataStamp from "../../../components/tools/kit/DataStamp.astro";
import SourcesList from "../../../components/tools/kit/SourcesList.astro";
import { levelTable } from "../../../lib/tools-payload";
import "../../../components/tools/kit/tools.css";

// Prefeitura first, then the 16 other A01 building tables in name order. Names come from the table names.
const SLUGS = [
  "academy", "alliance-center", "archery-range", "barracks", "castle", "farm", "goldmine", "hospital", "lumber-mill",
  "quarry", "scout-camp", "siege-workshop", "stable", "storehouse", "tavern", "wall", "watchtower",
];
const NAMES: Record<string, string> = {
  academy: "Academia", "alliance-center": "Centro da Aliança", "archery-range": "Campo de Arquearia", barracks: "Quartel", castle: "Castelo",
  farm: "Fazenda", goldmine: "Mina de Ouro", hospital: "Hospital", "lumber-mill": "Serraria", quarry: "Pedreira",
  "scout-camp": "Acampamento de Batedores", "siege-workshop": "Oficina de Cerco", stable: "Estábulo", storehouse: "Depósito",
  tavern: "Taverna", wall: "Muralha", watchtower: "Torre de Vigia",
};
const title = (slug: string) => NAMES[slug] ?? slug;
const tables = [
  { id: "A01-city-hall", name: "Prefeitura" },
  ...SLUGS.map((s) => ({ id: `A01-buildings-${s}`, name: title(s) })),
].map(({ id, name }) => {
  const t = levelTable(id);
  return {
    id, name, cite: t.cite,
    // Lean rows: only what the calculator reads (no stats columns).
    rows: t.rows.map(({ level, food, wood, stone, gold, seconds, extra, requirements, garbled }) => ({
      level, food, wood, stone, gold, seconds, extra, requirements, ...(garbled ? { garbled } : {}),
    })),
  };
});
const ids = tables.flatMap((t) => t.cite.facts);
---
<Shell title="Custo de construções" description="Comida, madeira, pedra, ouro, itens e tempo bruto de construção de um nível a outro, para a Prefeitura e todas as outras construções, com os requisitos do nível alvo." mode="operate">
  <div class="t-page">
    <header>
      <h1>Custo de construções</h1>
      <p class="t-lead">Escolha uma construção e dois níveis. Você vê os recursos, itens e o tempo bruto para chegar lá, e o que o nível alvo exige antes. Os valores ficam neste aparelho.</p>
      <DataStamp />
    </header>
    <BuildingsCalc client:load tables={tables} />
    <SourcesList ids={ids} />
  </div>
</Shell>

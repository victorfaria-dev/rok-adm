---
import Shell from "../../../layouts/Shell.astro";
import BuildingsCalc from "../../../components/tools/buildings/BuildingsCalc";
import DataStamp from "../../../components/tools/kit/DataStamp.astro";
import SourcesList from "../../../components/tools/kit/SourcesList.astro";
import { levelTable } from "../../../lib/tools-payload";
import "../../../components/tools/kit/tools.css";

// City Hall first, then the 16 other A01 building tables in name order. Names come from the table names.
const SLUGS = [
  "academy", "alliance-center", "archery-range", "barracks", "castle", "farm", "goldmine", "hospital", "lumber-mill",
  "quarry", "scout-camp", "siege-workshop", "stable", "storehouse", "tavern", "wall", "watchtower",
];
const title = (slug: string) => slug.split("-").map((w) => w[0]!.toUpperCase() + w.slice(1)).join(" ");
const tables = [
  { id: "A01-city-hall", name: "City Hall" },
  ...SLUGS.map((s) => ({ id: `A01-buildings-${s}`, name: title(s) })),
].map(({ id, name }) => {
  const t = levelTable(id);
  return {
    id, name, cite: t.cite,
    // Lean rows: only what the calculator reads (no stats columns).
    rows: t.rows.map(({ level, food, wood, stone, gold, seconds, extra, requirements, garbled }) => ({
      level, food, wood, stone, gold, seconds, extra, requirements, ...(garbled ? { garbled } : {}),
    })),
  };
});
const ids = tables.flatMap((t) => t.cite.facts);
---
<Shell title="Building costs" description="Food, wood, stone, gold, items and raw build time from one level to another for City Hall and every other building, with the requirements of the target level." mode="operate">
  <div class="t-page">
    <header>
      <h1>Building costs</h1>
      <p class="t-lead">Pick a building and two levels. You get the resources, items and raw build time to get there, and what the target level needs first. Values stay on this device.</p>
      <DataStamp />
    </header>
    <BuildingsCalc client:load tables={tables} />
    <SourcesList ids={ids} />
  </div>
</Shell>

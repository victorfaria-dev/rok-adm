---
import Shell from "../../../layouts/Shell.astro";
import KingdomNav from "../../../components/kingdom/shared/KingdomNav.astro";
import { Checklist } from "../../../components/tools/kit/Checklist";
import RuleList from "../../../components/tools/hoard/RuleList.astro";
import DataStamp from "../../../components/tools/kit/DataStamp.astro";
import SourcesList from "../../../components/tools/kit/SourcesList.astro";
import { cite } from "../../../lib/tools-payload";
import kvk from "../../../../../../packages/planner/tools-data/kvk.json";
import "../../../components/tools/kit/tools.css";

const groups = kvk.groups.map((g) => ({
  id: g.id,
  title: g.title,
  items: g.items.map((i) => ({
    id: i.id, text: i.text, ...("detail" in i && i.detail ? { detail: i.detail } : {}), cite: i.facts.length ? cite(i.facts) : null,
  })),
}));
const ids = [...kvk.groups.flatMap((g) => g.items.flatMap((i) => i.facts)), ...kvk.explainer.flatMap((e) => e.facts)];
---
<Shell title="Preparo para a KvK" description="Uma lista para o seu primeiro Reino contra Reino em Rise of Kingdoms (Prefeitura, tropas, hospital, acelerações, comandantes, aliança) e uma explicação simples da temporada. Cada item cita sua fonte." mode="operate">
  <div class="t-page">
    <KingdomNav section="events" leaderOnly />
    <header>
      <h1>Preparo para a KvK</h1>
      <p class="t-lead">Marque o que você já tem pronto para o Reino contra Reino (KvK). Suas marcações ficam neste aparelho. Itens sem ficha de fonte dizem "Sem consenso".</p>
      <DataStamp />
    </header>

    <section class="t-section" aria-labelledby="kvk-season-h">
      <h2 id="kvk-season-h">A temporada em uma página</h2>
      <RuleList rules={kvk.explainer} testId="kvk-explainer" />
    </section>

    <section class="t-section" aria-labelledby="kvk-list-h">
      <h2 id="kvk-list-h">Lista</h2>
      <nav class="t-links" aria-label="Ferramentas relacionadas">
        <a href="/tools/healing/">Planejador de cura</a>
        <a href="/tools/hoard/">Guia de acúmulo</a>
        <a href="/tools/migration/">Verificador de migração</a>
      </nav>
      {groups.map((g) => <Checklist client:load listId={`kvk-${g.id}`} title={g.title} items={g.items} level={3} />)}
    </section>

    <section class="t-deferred" aria-labelledby="t-deferred-h">
      <h2 id="t-deferred-h">Ainda não está aqui</h2>
      <ul>
        <li>Uma lista por função (líder de ataque em massa, guarnição, apoio) e por orçamento: depende de mais fichas.</li>
        <li>Calendários do KvK dia a dia por história: ainda não coletados.</li>
      </ul>
    </section>
    <SourcesList ids={ids} />
  </div>
</Shell>

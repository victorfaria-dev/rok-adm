---
// Short brand page: the logo, the K sting on demand (so it can be seen outside an installed PWA) and the colors.
import Shell from "../../layouts/Shell.astro";
import Logo from "../../components/Logo.astro";
import LogoSting from "../../components/LogoSting.astro";
import { ALLIANCE_COLORS } from "../../lib/card";
import { RARITIES, RARITY_LABELS } from "../../lib/rarity";
import styleguideUrl from "../../../../../design/styleguide.html?url";

const brand = [["graphite", "Graphite"], ["bronze", "Bronze"], ["ivory", "Ivory"]] as const;
---
<Shell title="Brand" description="The KingdomOps logo, its short motion sting and the interface colors." mode="read">
  <section class="hero">
    <h1>KingdomOps brand</h1>
    <p class="sub">Operations plus kingdom. The K is assembled like a machined part: three facets lock, then the name follows.</p>
    <div class="lockup"><Logo variant="horizontal" class="wide" /></div>
  </section>

  <section class="sting-demo" aria-labelledby="sting-h">
    <h2 id="sting-h">Logo sting</h2>
    <p>About 1.2 seconds, K only: the facets slide in on their own axes, lock with a small pop and a light sweeps across. In the installed app it plays once per session on launch; it never plays with reduced motion on.</p>
    <LogoSting mode="demo" />
    <div class="actions">
      <button type="button" class="btn btn-primary" data-sting-play>Play sting</button>
      <p class="note" data-sting-note hidden>Your system asks for reduced motion, so the sting stays off and the logo stays still.</p>
    </div>
  </section>

  <section class="colors" aria-labelledby="colors-h">
    <h2 id="colors-h">Colors</h2>
    <h3>Brand</h3>
    <ul class="swatches">
      {brand.map(([t, label]) => <li><span class="sw" style={`--c: var(--ko-${t})`}></span><span>{label}</span><code>--ko-{t}</code></li>)}
    </ul>
    <h3>Rarity</h3>
    <ul class="swatches">
      {RARITIES.map((r) => <li><span class="sw" style={`--c: var(--ko-rarity-${r})`}></span><span>{RARITY_LABELS[r]}</span><code>--ko-rarity-{r}</code></li>)}
    </ul>
    <h3>Alliance</h3>
    <ul class="swatches">
      {ALLIANCE_COLORS.map((c) => <li><span class="sw" style={`--c: var(--ko-alliance-${c})`}></span><span>{c}</span><code>--ko-alliance-{c}</code></li>)}
    </ul>
    <p class="more">Every color, type size and spacing step with its contrast check: <a href={styleguideUrl}>open the style guide</a>.</p>
  </section>
</Shell>

<style>
  .hero { display: grid; gap: var(--ko-space-4); padding-block: var(--ko-space-2) var(--ko-space-8); }
  h1 { font-size: var(--ko-text-3xl); line-height: var(--ko-leading-3xl); }
  .sub { color: var(--ko-text-muted); max-width: 52ch; }
  .lockup { padding: var(--ko-space-8) var(--ko-space-6); background: var(--ko-surface); border: 1px solid var(--ko-border); display: grid; place-items: center; }
  .lockup :global(.wide) { width: min(100%, 320px); height: auto; }
  h2 { font-size: var(--ko-text-sm); letter-spacing: .08em; text-transform: uppercase; color: var(--ko-text-muted); }
  h3 { font-size: var(--ko-text-md); margin-top: var(--ko-space-2); }
  section + section { margin-top: var(--ko-space-10); }
  .sting-demo, .colors { display: grid; gap: var(--ko-space-4); }
  .sting-demo p, .more { color: var(--ko-text-muted); font-size: var(--ko-text-sm); line-height: var(--ko-leading-sm); }
  .actions { display: grid; gap: var(--ko-space-3); justify-items: start; }
  .note { color: var(--ko-text); }
  .swatches { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: var(--ko-space-3); }
  .swatches li { display: grid; gap: var(--ko-space-1); font-size: var(--ko-text-sm); }
  .sw { display: block; height: 40px; background: var(--c); border: 1px solid var(--ko-border); }
  code { font-family: var(--ko-font-mono); font-size: var(--ko-text-xs); color: var(--ko-text-muted); }
  .more a { color: var(--ko-text); }
</style>

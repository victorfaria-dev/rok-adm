---
// F-60 Governor card: Experience mode (one brand moment), Operate for the form below it.
import Shell from "../../layouts/Shell.astro";
import GovernorCard from "../../components/GovernorCard.tsx";
import { RARITIES, RARITY_LABELS, RARITY_MEANING, RARITY_RANGES } from "../../lib/rarity";
---
<Shell title="Governor card" description="Your collectible governor card: rarity by City Hall, alliance colors and a PNG avatar you can download." mode="operate">
  <section class="intro">
    <h1>Governor card</h1>
    <p class="sub">One number sets the rarity: your City Hall. Tilt it, make it yours, download the PNG as your avatar.</p>
  </section>

  <GovernorCard client:load />

  <section class="rules" aria-labelledby="rules-h">
    <h2 id="rules-h">How rarity is earned</h2>
    <table>
      <thead><tr><th scope="col">Rarity</th><th scope="col">City Hall</th><th scope="col">What it means in the game</th></tr></thead>
      <tbody>
        {RARITIES.map((r) => {
          const [lo, hi] = RARITY_RANGES[r];
          return (
            <tr>
              <td><span class="pill" style={`color: var(--ko-rarity-${r})`}>{RARITY_LABELS[r]}</span></td>
              <td class="mono">{lo === hi ? lo : `${lo}–${hi}`}</td>
              <td>{RARITY_MEANING[r]}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
    <p>Rarity measures progress, not skill: spenders get there sooner, but every account can reach Legendary. F2P accounts at Rare or above carry the F2P Achiever mark.</p>
    <p>Every card is <strong>Self-reported</strong> for now. The <strong>Verified</strong> seal (one City Hall screenshot) comes with the screenshot reader, which is not built yet. Nothing here uses game art: the card draws the KingdomOps K and your own words.</p>
  </section>
</Shell>

<style>
  .intro { display: grid; gap: var(--ko-space-3); padding-block: var(--ko-space-2) var(--ko-space-8); }
  h1 { font-size: var(--ko-text-3xl); line-height: var(--ko-leading-3xl); }
  .sub { color: var(--ko-text-muted); max-width: 48ch; }
  .rules { display: grid; gap: var(--ko-space-4); margin-top: var(--ko-space-12); }
  h2 { font-size: var(--ko-text-sm); letter-spacing: .08em; text-transform: uppercase; color: var(--ko-text-muted); }
  table { border-collapse: collapse; width: 100%; font-size: var(--ko-text-sm); }
  th, td { text-align: left; padding: var(--ko-space-2) var(--ko-space-3); border-bottom: 1px solid var(--ko-border); vertical-align: top; }
  th { font-size: var(--ko-text-xs); letter-spacing: .04em; text-transform: uppercase; color: var(--ko-text-muted); font-weight: var(--ko-weight-semibold); }
  .pill { font: var(--ko-weight-semibold) var(--ko-text-xs)/1 var(--ko-font-display); letter-spacing: .08em; text-transform: uppercase; padding: 6px 10px; border: 1px solid currentColor; white-space: nowrap; }
  .rules p { color: var(--ko-text-muted); font-size: var(--ko-text-sm); line-height: var(--ko-leading-sm); max-width: 72ch; }
  .rules strong { color: var(--ko-text); font-weight: var(--ko-weight-semibold); }
</style>

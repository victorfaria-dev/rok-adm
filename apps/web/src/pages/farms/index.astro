---
import Shell from "../../layouts/Shell.astro";
import FarmsNav from "../../components/farms/shared/FarmsNav.astro";
import FarmHub from "../../components/farms/hub/FarmHub";
import "../../components/farms/shared/farms.css";
---
<Shell title="Contas farm" description="Planeje e acompanhe suas próprias contas farm: qual visitar em seguida, uma lista diária, metas diárias e um registro de envios. Fica neste navegador." mode="operate">
  <div class="fm">
    <header class="fm-head">
      <h1>Contas farm</h1>
      <p class="fm-lead">Acompanhe suas contas farm: quando as marchas de cada uma voltam, o que falta na lista de hoje e quanto a principal recebeu.</p>
      <p class="fm-note" data-guardrail><strong>Só planejamento e anotações. Você faz cada ação no jogo por conta própria.</strong></p>
    </header>
    <FarmsNav />
    <FarmHub client:load />
  </div>
</Shell>

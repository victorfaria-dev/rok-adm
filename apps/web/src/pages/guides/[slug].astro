---
// Wave H and J guides (first 30 days, low spender, returning, recovery, kingdom admin, late game):
// static pages rendered at build from guides/data/blocks.<set>.json with the same
// block component as /guide/. No island: readable with JS off, no client payload.
import Shell from "../../layouts/Shell.astro";
import { GuideBody, GuideConfidence, GuideMeta } from "../../components/guide/GuideBody";
import { buildGuidePayload } from "../../lib/guide-payload";
import { fullGuide } from "../../lib/guide-view";
import { STATIC_GUIDES, type GuidePage } from "../../lib/guides";
import { guideSetById, type GuideSetId } from "@rokadm/core";
import { GuideVisual } from "../../components/guide/GuideVisual";
import TimelineScript from "../../components/guide/TimelineScript.astro";
import { buildTimeline } from "../../lib/guide-timeline";
import "../../styles/guide.css";

export function getStaticPaths() {
  return STATIC_GUIDES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: GuidePage };
const set = page.set as GuideSetId;
const payload = buildGuidePayload(set);
const view = fullGuide(payload, guideSetById(set).sectionTitles);
const hasTimeline = buildTimeline(view, payload.badges).show;
const forWho = page.audience.replace(/\.$/, "");
---
<Shell title={page.title} description={`${page.summary} ${page.audience}`} mode="read">
  <div class="g-page" data-guide-set={set}>
    <h1>{page.title}</h1>
    <GuideMeta view={view} label={`For: ${forWho}`} />
    <GuideConfidence view={view} />
    {set === "low" ? (
      <p class="g-intro">
        These steps are a delta over the F2P plan: a step here replaces the F2P step with the same topic, the rest are added.
        If your profile is Low or higher, <a href="/guide/">your guide</a> already merges them in.
      </p>
    ) : set === "latestage" ? (
      <p class="g-intro">
        The plan after KvK1, for kingdoms in KvK2, KvK3 or Season of Conquest. If your profile is at one of those stages,
        <a href="/guide/">your guide</a> shows these steps as its main plan. Other guides are on <a href="/guides/">all guides</a>.
      </p>
    ) : set === "recovery" ? (
      <p class="g-intro">Start with the first step, even if you read nothing else today. Then come back for the rest. Other guides are on <a href="/guides/">all guides</a>.</p>
    ) : (
      <p class="g-intro">{page.summary} Use it alongside <a href="/guide/">your guide</a>; other guides are on <a href="/guides/">all guides</a>.</p>
    )}
    {hasTimeline && <GuideVisual view={view} badges={payload.badges} title="Timeline" />}
    <GuideBody view={view} badges={payload.badges} profileTags={false} />
    {hasTimeline && <TimelineScript />}
  </div>
</Shell>

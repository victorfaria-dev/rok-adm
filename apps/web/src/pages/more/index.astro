---
// /more/: the phone "More" list as a page, for browsers without JavaScript (MoreMenu.astro links here).
import Shell from "../../layouts/Shell.astro";
import { DESTINATIONS, SECONDARY } from "../../lib/nav";
---
<Shell title="More" description="Every KingdomOps page: guides, tools, farms, kingdom council, governor card, alliance crest, trust and brand." mode="read">
  <div class="mp">
    <h1>More pages</h1>
    <nav aria-labelledby="mp-more-h">
      <h2 id="mp-more-h">More</h2>
      <ul class="mp-list" data-more-list>
        {SECONDARY.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </nav>
    <nav aria-labelledby="mp-main-h">
      <h2 id="mp-main-h">Main</h2>
      <ul class="mp-list">
        {DESTINATIONS.map((d) => <li><a href={d.href}>{d.label}</a></li>)}
      </ul>
    </nav>
  </div>
</Shell>

<style>
  .mp { display: grid; gap: var(--ko-space-5); }
  .mp h2 { font-size: var(--ko-text-lg); margin-bottom: var(--ko-space-2); }
  .mp-list { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--ko-border); }
  .mp-list li { border-bottom: 1px solid var(--ko-border); }
  .mp-list a { display: flex; align-items: center; min-height: 48px; padding-inline: var(--ko-space-2); color: var(--ko-text); }
  .mp-list a:focus-visible { outline: 2px solid var(--ko-focus); outline-offset: -2px; }
</style>

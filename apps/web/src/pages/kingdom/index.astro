---
// Kingdom tab, Overview (UX stage 1): the leader's home. One in-section nav (no card grid, no
// More menu); the guardrail, privacy and council data live here once, not on every sub-page.
import Shell from "../../layouts/Shell.astro";
import KingdomNav from "../../components/kingdom/shared/KingdomNav.astro";
import PrivacyNote from "../../components/kingdom/shared/PrivacyNote.astro";
import DataControls from "../../components/kingdom/shared/DataControls";
import { WebhookSettings } from "../../components/discord/DiscordPost";
import "../../components/kingdom/shared/kingdom.css";

// Todos os textos desta página, num lugar só.
const S = {
  title: "Reino",
  description: "Para reis, R4 e conselheiros: página de regras, brasão da aliança, requisitos dos membros, recrutamento e planejamento de MGE e KvK. Funciona no seu navegador.",
  h1: "Seu reino",
  lead: "Para reis, R4 e conselheiros. Publique regras claras, defina o que você pede dos membros, recrute para as funções de que precisa e planeje os eventos de forma aberta.",
  guardrail: "Só planejamento e publicação. Sem bots, sem varredura, sem arquivos do jogo. Você faz cada ação no jogo por conta própria.",
  whereH: "Onde fica cada coisa",
  where: [
    { tab: "Reino", text: "Página de regras, brasão da aliança e o simulador de seed (experimental)." },
    { tab: "Membros", text: "Cartão de requisitos com a sua fórmula de DKP, post de recrutamento e a página em que os jogadores veem a própria meta." },
    { tab: "Eventos", text: "Planejador de MGE com uma regra que todos podem conferir, e o planejador de KvK." },
  ],
  adminGuide: "Está começando a administrar um reino? Leia o",
  adminGuideLink: "guia de administração do reino",
  dataH: "Dados do seu conselho",
  dataNote: "Salvos só neste navegador. Exporte um arquivo para levar a outro aparelho ou passar a outro oficial.",
  discordH: "Webhook do Discord",
  discordNote: "Cole o webhook do seu servidor uma vez e o planejador de MGE, a página de regras e o post de recrutamento (e o registro de farms) ganham um botão \"Postar no Discord\". Você sempre vê a mensagem exata antes, e nada é enviado até você apertar Enviar.",
};
---
<Shell title={S.title} description={S.description} mode="operate">
  <div class="kg">
    <header class="kg-head">
      <h1>{S.h1}</h1>
      <p class="kg-lead">{S.lead}</p>
      <p class="kg-note" data-guardrail><strong>{S.guardrail}</strong></p>
    </header>
    <KingdomNav section="kingdom" />
    <section aria-labelledby="where-h" class="kg-grid">
      <h2 id="where-h">{S.whereH}</h2>
      <dl class="kg-where">
        {S.where.map((w) => <div><dt>{w.tab}</dt><dd>{w.text}</dd></div>)}
      </dl>
      <p class="kg-note">{S.adminGuide} <a href="/guides/kingdom-admin/">{S.adminGuideLink}</a>.</p>
    </section>
    <div id="privacy"><PrivacyNote thirdParty /></div>
    <section id="data" aria-labelledby="data-h" class="kg-grid">
      <h2 id="data-h">{S.dataH}</h2>
      <p class="kg-note">{S.dataNote}</p>
      <DataControls client:load />
    </section>
    <section id="discord" aria-labelledby="discord-h" class="kg-grid">
      <h2 id="discord-h">{S.discordH}</h2>
      <p class="kg-note">{S.discordNote}</p>
      <div class="kg-card"><WebhookSettings client:load id="hub" /></div>
    </section>
  </div>
</Shell>

<style>
  .kg-where { margin: 0; display: grid; gap: var(--ko-space-3); }
  .kg-where div { display: grid; gap: var(--ko-space-1); padding-left: var(--ko-space-3); border-left: 2px solid var(--ko-accent); }
  .kg-where dt { font: var(--ko-weight-semibold) var(--ko-text-md)/1.3 var(--ko-font-display); }
  .kg-where dd { margin: 0; color: var(--ko-text-muted); font-size: var(--ko-text-sm); line-height: var(--ko-leading-sm); }
</style>

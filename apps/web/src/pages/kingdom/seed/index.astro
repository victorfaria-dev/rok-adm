---
import Shell from "../../../layouts/Shell.astro";
import KingdomNav from "../../../components/kingdom/shared/KingdomNav.astro";
import SeedSimulator from "../../../components/kingdom/seed/SeedSimulator";
import { CONFIDENCE_LABEL, SEED_RULE, SEED_SOURCES } from "@rokadm/planner";
import "../../../components/kingdom/shared/kingdom.css";
import "../../../components/kingdom/seed/seed.css";

const ASSUMPTIONS = [
  { text: "Bands are marginal, like tax brackets: each rate applies only to the part of a governor's power inside its band. The patch note says \"80% of your power from 150,000,000 to 300,000,000\". So 200M counts as 150M + 80% of 50M = 190M, and no governor counts for more than 370M.", src: "B08-0008" },
  { text: "Only the top 300 governors by individual power count. This comes from Lilith's April 2025 Q&A, not from the patch note itself.", src: "B08-0008" },
  { text: "Imperium threshold: 23.5B of this counted power. The thresholds for seeds A, B, C and D are not published, so no seed letter is predicted.", src: "B08-0008, B01-0001" },
  { text: "Hypothesis: a governor with a Vacation Permit is removed from this counted power, and the next governor moves into the top 300. The patch notes only say permit holders are not counted toward the \"matchmaking score\". Whether that is this same number is not stated.", src: "B03-0007, open question L-B03-03" },
  { text: "\"Zeroing\": the power you type replaces the governor's power and counts like any other power.", src: "planner assumption" },
  { text: "Not modelled: since 1.0.96 matchmaking also uses average power and total kill points; team-ups (1.1.03) add up team power. Neither is in this simulator.", src: "B08-0008 notes" },
  { text: "Quick mode puts every governor of a band at the average you enter, or at the middle of the band when you leave it empty.", src: "planner assumption" },
  { text: `The rule was last verified for patch ${SEED_RULE.patch}. Its check date (${SEED_RULE.checkBy}) has passed, so a later patch may have changed it.`, src: "B08-0008" },
];
---
<Shell title="Seed simulator" description="Experimental: see how much of your top 300 governors' power counts toward kingdom power under the 1.0.95 rule, and what changes with Vacation Permits. Works in your browser." mode="operate">
  <div class="kg">
    <header class="kg-head">
      <span class="kg-badge" data-experimental>Experimental</span>
      <h1>Seed simulator</h1>
      <p class="kg-lead">Paste your governors' powers and see the kingdom power that counts for Season of Conquest seeding under the 1.0.95 rule: only the top 300, with power above 150M counting less.</p>
    </header>
    <KingdomNav section="kingdom" />
    <SeedSimulator client:load />
    <section class="kg-grid" aria-labelledby="ks-assume-h">
      <h2 id="ks-assume-h">Assumptions</h2>
      <ol class="ks-assumptions" data-assumptions>
        {ASSUMPTIONS.map((a) => <li>{a.text} <span class="kg-hint">({a.src})</span></li>)}
      </ol>
    </section>
    <section class="kg-grid" aria-labelledby="ks-src-h">
      <h2 id="ks-src-h">Where this comes from</h2>
      <ul class="ks-sources" data-sources>
        {SEED_SOURCES.map((s) => <li><strong>{s.id}</strong> (confidence: {CONFIDENCE_LABEL[s.confidence]}): {s.text}</li>)}
      </ul>
    </section>
  </div>
</Shell>

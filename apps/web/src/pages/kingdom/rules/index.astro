---
import Shell from "../../../layouts/Shell.astro";
import KingdomNav from "../../../components/kingdom/shared/KingdomNav.astro";
import RulesBuilder from "../../../components/kingdom/rules/RulesBuilder";
import "../../../components/kingdom/shared/kingdom.css";
import "../../../components/kingdom/rules/rules.css";
---
<Shell title="Rules page" description="Write your kingdom's rules and charter in sections, start from prompts for common topics, then share a view-only link or print it. Stays in your browser." mode="operate">
  <div class="kg">
    <header class="kg-head">
      <h1>Kingdom rules page</h1>
      <p class="kg-lead">Write your kingdom's rules where every member, migrant and language group can read them: one page, in sections, with a view-only link and a printable version.</p>
    </header>
    <KingdomNav section="kingdom" />
    <RulesBuilder client:load />
    <p class="kg-note">How other councils agree, log and review their rules: read the <a href="/guides/kingdom-admin/">kingdom admin guide</a>. For KvK requirements, build a <a href="/kingdom/requirements/">requirements card</a> and link it from your rules.</p>
  </div>
</Shell>

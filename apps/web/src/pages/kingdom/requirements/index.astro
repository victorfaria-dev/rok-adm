---
import Shell from "../../../layouts/Shell.astro";
import KingdomNav from "../../../components/kingdom/shared/KingdomNav.astro";
import RequirementsBuilder from "../../../components/kingdom/requirements/RequirementsBuilder";
import "../../../components/kingdom/shared/kingdom.css";
import "../../../components/kingdom/requirements/requirements.css";
---
<Shell title="Requirements card" description="Define your kingdom's DKP formula and KvK requirement, test it on sample accounts and publish a card your players can open to see their own target." mode="operate">
  <div class="kg">
    <header class="kg-head">
      <h1>Requirements card</h1>
      <p class="kg-lead">Write your DKP formula and KvK requirement, check it on sample accounts, then publish one link every player can open to see their own target.</p>
    </header>
    <KingdomNav section="members" />
    <RequirementsBuilder client:load />
  </div>
</Shell>

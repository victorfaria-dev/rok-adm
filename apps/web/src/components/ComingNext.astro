---
interface Props { what: string; when: string }
const { what, when } = Astro.props;
---
<section class="next">
  <h1><slot name="title" /></h1>
  <p>{what}</p>
  <p class="when">{when}</p>
  <div class="actions">
    <a class="btn btn-primary" href="/start/">Build my guide</a>
    <a class="btn btn-secondary" href="/guides/new-kingdom/">New kingdom guide</a>
  </div>
</section>

<style>
  .next { display: grid; gap: var(--ko-space-4); padding-block: var(--ko-space-6); }
  h1 { font-size: var(--ko-text-3xl); line-height: var(--ko-leading-3xl); }
  p { color: var(--ko-text-muted); }
  .when { font: var(--ko-text-xs)/1.4 var(--ko-font-mono); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--ko-space-3); margin-top: var(--ko-space-2); }
</style>

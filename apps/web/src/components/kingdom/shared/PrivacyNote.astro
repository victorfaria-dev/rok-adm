---
interface Props {
  /** Extra sentence for tools that hold other players' data (names, stats). */
  thirdParty?: boolean;
}
const { thirdParty = false } = Astro.props;
---
<aside class="kg-privacy kg-noprint" data-privacy aria-labelledby="kg-privacy-h">
  <h2 id="kg-privacy-h">Privacy</h2>
  <ul>
    <li>Everything you type stays in this browser. Nothing is sent to a server.</li>
    <li>A share link carries the document inside the link itself. Anyone with the link can read it, so share it only where you mean to.</li>
    {thirdParty && <li>Only enter other players' names and numbers that your council collected itself and that they agreed to share. Do not paste passwords, emails or scans you were not allowed to make.</li>}
    <li>Export, import or delete all council data in <a href="/kingdom/#data">Your council data</a> below.</li>
  </ul>
</aside>

---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import ThemePicker from "../components/ThemePicker.astro";
import ProfileChip from "../components/ProfileChip.astro";
import Footer from "../components/Footer.astro";
import LogoSting from "../components/LogoSting.astro";
import MoreMenu from "../components/MoreMenu.astro";
import { DESTINATIONS, SECONDARY, isActive } from "../lib/nav";
import { THEME_BOOT_SCRIPT } from "../lib/theme";

interface Props {
  /** Page title shown in the top bar and <title>. */
  title: string;
  description: string;
  /** read = long text (72ch), operate = tools (960px). */
  mode?: "read" | "operate";
  /** Hide tabs/rail (full-screen flows like the questionnaire). */
  bare?: boolean;
  /** Home uses the brand name as its document title. */
  docTitle?: string;
}
const { title, description, mode = "read", bare = false, docTitle } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = docTitle ?? `${title} · KingdomOps`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <script is:inline set:html={THEME_BOOT_SCRIPT} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101214" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class:list={[{ bare }]}>
    <LogoSting />
    <a class="skip" href="#main">Skip to content</a>

    {!bare && (
      <header class="top">
        <a class="home" href="/" aria-label="KingdomOps home"><Logo variant="icon" class="k" /></a>
        <p class="page" aria-hidden="true">{title}</p>
        <ThemePicker id="top" placement="down" />
        <ProfileChip />
        <MoreMenu />
      </header>
    )}

    {!bare && (
      <nav class="rail" aria-label="Main">
        <a class="brand" href="/" aria-label="KingdomOps home">
          <Logo variant="icon" class="k" />
          <Logo variant="horizontal" class="wide" />
        </a>
        <ul class="dest">
          {DESTINATIONS.map((d) => (
            <li>
              <a href={d.href} aria-current={isActive(d.href, path) ? "page" : undefined}>
                <Icon name={d.icon} />
                <span class="short">{d.short}</span>
                <span class="long">{d.label}</span>
              </a>
            </li>
          ))}
        </ul>
        <ul class="secondary">
          {SECONDARY.map((s) => (
            <li><a href={s.href} aria-current={isActive(s.href, path) ? "page" : undefined}>{s.label}</a></li>
          ))}
        </ul>
        <div class="rail-foot">
          <ThemePicker id="rail" placement="up" />
          <ProfileChip />
        </div>
      </nav>
    )}

    <main id="main" class:list={["main", mode]} tabindex="-1">
      <slot />
      <Footer />
    </main>

    {!bare && (
      <nav class="tabs" aria-label="Main">
        <ul>
          {DESTINATIONS.map((d) => (
            <li>
              <a href={d.href} aria-current={isActive(d.href, path) ? "page" : undefined}>
                <Icon name={d.icon} />
                <span>{d.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <script>
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(() => {});
      }
    </script>
  </body>
</html>

<style>
  :root { --top-h: 56px; --tabs-h: 64px; --rail-w: 0px; }

  .skip {
    position: fixed; z-index: 100; left: var(--ko-space-4); top: calc(env(safe-area-inset-top, 0px) + var(--ko-space-2));
    padding: var(--ko-space-3) var(--ko-space-4); background: var(--ko-accent); color: var(--ko-on-accent);
    transform: translateY(-200%);
  }
  .skip:focus { transform: none; }

  /* Top bar: phone + tablet. */
  .top {
    position: fixed; z-index: 10; top: 0; left: var(--rail-w); right: 0;
    height: calc(var(--top-h) + env(safe-area-inset-top, 0px));
    padding: env(safe-area-inset-top, 0px) var(--ko-space-2) 0 var(--ko-space-4);
    display: flex; align-items: center; gap: var(--ko-space-2);
    background: var(--ko-background); border-bottom: 1px solid var(--ko-border);
  }
  .home { display: flex; align-items: center; min-height: 48px; }
  .home :global(.k) { width: 28px; height: auto; }
  .page {
    flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font: var(--ko-weight-semibold) var(--ko-text-md)/1 var(--ko-font-display); letter-spacing: .02em;
  }
  .top :global(.chip) { max-width: 40vw; }

  /* Bottom tabs: phone only. */
  .tabs {
    position: fixed; z-index: 10; left: 0; right: 0; bottom: 0;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    background: var(--ko-background); border-top: 1px solid var(--ko-border);
  }
  .tabs ul { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; padding: 0; list-style: none; }
  .tabs a {
    min-height: var(--tabs-h); display: grid; place-items: center; align-content: center; gap: 2px;
    color: var(--ko-text-muted); text-decoration: none; font-size: var(--ko-text-xs); position: relative;
  }
  .tabs a[aria-current="page"] { color: var(--ko-accent); }
  .tabs a[aria-current="page"]::before {
    content: ""; position: absolute; top: 0; left: 30%; right: 30%; height: 2px; background: var(--ko-accent);
  }

  /* Rail: tablet (80 px) and desktop (240 px). */
  .rail { display: none; }

  .main {
    padding-inline: var(--ko-space-4);
    padding-top: calc(var(--top-h) + env(safe-area-inset-top, 0px) + var(--ko-space-6));
    padding-bottom: calc(var(--tabs-h) + env(safe-area-inset-bottom, 0px) + var(--ko-space-6));
    margin-left: var(--rail-w);
    outline: none;
  }
  .main > :global(*) { margin-inline: auto; }
  .read > :global(*) { max-width: 72ch; }
  .operate > :global(*) { max-width: 960px; }
  .bare .main { padding-top: calc(env(safe-area-inset-top, 0px) + var(--ko-space-6)); padding-bottom: calc(env(safe-area-inset-bottom, 0px) + var(--ko-space-6)); margin-left: 0; }

  @media (min-width: 768px) {
    :root { --rail-w: 80px; }
    .tabs { display: none; }
    .main { padding-bottom: var(--ko-space-8); padding-inline: var(--ko-space-8); }
    .rail {
      display: flex; flex-direction: column; position: fixed; z-index: 11; top: 0; bottom: 0; left: 0; width: var(--rail-w);
      padding: calc(env(safe-area-inset-top, 0px) + var(--ko-space-4)) 0 var(--ko-space-4);
      background: var(--ko-surface); border-right: 1px solid var(--ko-border);
      overflow-y: auto; overscroll-behavior: contain;
    }
    .brand { display: flex; justify-content: center; padding-block: var(--ko-space-2) var(--ko-space-6); }
    .brand :global(.k) { width: 32px; height: auto; }
    .brand :global(.wide) { display: none; }
    .rail ul { list-style: none; margin: 0; padding: 0; }
    .dest a {
      display: grid; justify-items: center; gap: 2px; padding-block: var(--ko-space-3); min-height: 56px;
      color: var(--ko-text-muted); text-decoration: none; font-size: var(--ko-text-xs); position: relative;
    }
    .dest a[aria-current="page"] { color: var(--ko-accent); }
    .dest a[aria-current="page"]::before { content: ""; position: absolute; left: 0; top: 20%; bottom: 20%; width: 2px; background: var(--ko-accent); }
    .dest .long, .secondary, .rail-foot { display: none; }
    .bare .main { margin-left: 0; }
  }

  @media (min-width: 1024px) {
    :root { --rail-w: 240px; }
    .top { display: none; }
    .main { padding-top: calc(env(safe-area-inset-top, 0px) + var(--ko-space-10)); }
    .rail { padding-inline: var(--ko-space-4); }
    .brand { justify-content: flex-start; padding-inline: var(--ko-space-2); }
    .brand :global(.k) { display: none; }
    .brand :global(.wide) { display: block; width: 176px; height: auto; }
    .dest a { display: flex; align-items: center; gap: var(--ko-space-3); justify-items: start; padding-inline: var(--ko-space-3); min-height: 48px; font-size: var(--ko-text-md); }
    .dest a[aria-current="page"] { background: var(--ko-surface-raised); color: var(--ko-text); }
    .dest a[aria-current="page"] :global(.icon) { color: var(--ko-accent); }
    .dest .short { display: none; }
    .dest .long { display: inline; }
    .secondary { display: grid; gap: var(--ko-space-1); margin-top: var(--ko-space-6); padding-top: var(--ko-space-4); border-top: 1px solid var(--ko-border); }
    .secondary a { display: flex; align-items: center; min-height: 40px; padding-inline: var(--ko-space-3); color: var(--ko-text-muted); text-decoration: none; font-size: var(--ko-text-sm); }
    .secondary a[aria-current="page"] { color: var(--ko-text); }
    .rail-foot { display: grid; gap: var(--ko-space-2); margin-top: auto; justify-items: start; }
  }
  @media (hover: hover) and (pointer: fine) {
    .dest a:hover, .secondary a:hover, .tabs a:hover { color: var(--ko-text); }
  }
</style>
